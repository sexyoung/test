{
  "name": "low-poly-engine-showdown",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The same low-poly park scene built with Three.js, Babylon.js and PlayCanvas, plus a benchmark harness",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "check": "node bench/run.mjs --quick",
    "bench": "node bench/run.mjs",
    "models": "node scripts/make-glb.mjs",
    "models:park": "node scripts/make-park-glb.mjs",
    "check:park:assets": "node scripts/check-park-assets.mjs",
    "check:park:environment": "node scripts/check-park-environment.mjs",
    "check:park:landscape": "node scripts/check-park-landscape.mjs",
    "check:park:backdrop": "node scripts/check-park-backdrop.mjs",
    "check:photo-cat": "node scripts/check-photo-cat.mjs",
    "photo-cat:ai": "node server/photo-cat-mlx/server.mjs",
    "check:photo-dog": "node scripts/check-photo-dog.mjs",
    "check:photo-cat-breed": "node scripts/check-photo-cat-breed.mjs",
    "check:photo-persian": "node scripts/check-photo-persian.mjs",
    "check:physical-size": "node scripts/check-physical-size.mjs",
    "check:static-cat-bases": "node scripts/check-static-cat-bases.mjs",
    "check:photo-analysis": "node scripts/check-photo-analysis.mjs",
    "check:photo-cat-facets": "node scripts/check-photo-cat-facets.mjs",
    "models:cat-head": "python3 scripts/attach-approved-cat-head.py",
    "check:cat": "node scripts/check-cat.mjs",
    "models:cat-neck-blender": "\"/Applications/Blender.app/Contents/MacOS/Blender\" --background --python scripts/refine-cat-neck-blender.py",
    "models:cat-blend": "\"/Applications/Blender.app/Contents/MacOS/Blender\" --background --python scripts/save-cat-neck-blend.py",
    "models:cat-head-skin": "\"/Applications/Blender.app/Contents/MacOS/Blender\" --background --python scripts/transfer-cat-head-skin-blender.py",
    "check:head-deformation": "node scripts/check-head-deformation.mjs",
    "models:cat-proportions": "\"/Applications/Blender.app/Contents/MacOS/Blender\" --background --python scripts/refine-cat-proportions-blender.py",
    "models:cat-continuity": "\"/Applications/Blender.app/Contents/MacOS/Blender\" --background --python scripts/refine-cat-continuity-blender.py",
    "models:cat-run-skin": "\"/Applications/Blender.app/Contents/MacOS/Blender\" --background --python scripts/refine-cat-run-skin-blender.py",
    "models:cat-editable-rig": "\"/Applications/Blender.app/Contents/MacOS/Blender\" --background --python scripts/refine-cat-editable-rig-blender.py",
    "models:cat-connected-rig": "\"/Applications/Blender.app/Contents/MacOS/Blender\" --background --python scripts/connect-cat-limb-rig-blender.py",
    "check:cat-connected-rig": "\"/Applications/Blender.app/Contents/MacOS/Blender\" --background --python scripts/check-cat-rig-blender.py -- --connected",
    "models:cat-ear-controls": "\"/Applications/Blender.app/Contents/MacOS/Blender\" --background --python scripts/add-cat-ear-controls-blender.py",
    "check:cat-ear-controls": "\"/Applications/Blender.app/Contents/MacOS/Blender\" --background --python scripts/check-cat-rig-blender.py -- --ears",
    "models:cat-base": "\"/Applications/Blender.app/Contents/MacOS/Blender\" --background --python scripts/export-cat-base-blender.py && node scripts/finalize-cat-base.mjs && node scripts/check-cat-base.mjs",
    "check:cat-base": "node scripts/check-cat-base.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^9.36.0",
    "playcanvas": "^2.24.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "playwright-core": "^1.65.0",
    "vite": "^8.3.8"
  }
}
